      "file": "konkani.json"
    },
    {
      "code": "mai",
      "name": "Maithili",
      "file": "maithili.json"
    },
    {
      "code": "ml",
      "name": "Malayalam",
      "file": "malayalam.json"
    },
    {
      "code": "mni",
      "name": "Manipuri",
