{
  "project": {
    "name": "Vidhwaan Bhagavad Gita Multilingual",
    "sourceFile": "gita.json",
    "sourceLanguage": "Telugu",
    "totalEntries": 100,
    "batchSize": 5,
    "model": "openai/gpt-oss-120b",
    "provider": "groq",
    "maxRetries": 3
  },
  "translation": {
    "preserveIds": true,
    "preserveOrder": true,
    "preserveSanskritVerse": true,
    "preserveJsonStructure": true,
    "allowAdditionalFields": false,
    "allowMissingEntries": false,
    "allowDuplicateEntries": false,
    "allowSummarization": false,
    "allowExpansion": false,
    "translateTitles": true,
    "translateContent": true
  },
  "languages": [
    {
      "code": "en",
      "name": "English",
      "file": "english.json"
    },
    {
