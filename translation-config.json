    {
      "code": "ur",
      "name": "Urdu",
      "file": "urdu.json"
    }
  ],
  "rateLimit": {
    "useResponseHeaders": true,
    "respectRetryAfter": true,
    "waitOnRateLimit": true,
    "minimumDelayBetweenRequestsMs": 3000
  },
  "validation": {
    "requireExactly100Entries": true,
    "requireSequentialIds": true,
    "requireExactObjectKeys": true,
    "requireSanskritPreservation": true,
    "requireNonEmptyTitle": true,
    "requireNonEmptyContent": true,
    "runSemanticValidation": true
  },
  "output": {
    "encoding": "utf-8",
    "prettyPrint": true,
    "finalFileExtension": ".json",
    "commitAfterEachLanguage": true
  }
}
